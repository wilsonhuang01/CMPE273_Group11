{
  "uid": "compiler-optimizer",
  "title": "Compiler Optimizer: execution and recovery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "compiler",
    "recovery"
  ],
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "workload",
        "type": "custom",
        "label": "Evidence store",
        "query": "optimizer-host,optimizer-services",
        "current": {
          "text": "optimizer-host",
          "value": "optimizer-host"
        },
        "options": [
          {
            "text": "optimizer-host",
            "value": "optimizer-host",
            "selected": true
          },
          {
            "text": "optimizer-services",
            "value": "optimizer-services",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth (ready and unacknowledged)",
      "datasource": {
        "type": "prometheus",
        "uid": "optimizer-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "rabbitmq_queue_messages_unacked",
          "legendFormat": "unacknowledged"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Task states",
      "datasource": {
        "type": "prometheus",
        "uid": "optimizer-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "optimizer_tasks{job=\"$workload\"}",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Task duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "optimizer-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,status) (optimizer_task_duration_seconds_bucket{job=\"$workload\"}))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Oldest active task",
      "datasource": {
        "type": "prometheus",
        "uid": "optimizer-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "optimizer_oldest_active_task_seconds{job=\"$workload\"}",
          "legendFormat": "oldest active task"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
