{
  "openapi": "3.1.0",
  "info": {
    "title": "Compiler optimizer browser adapter",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/examples": {
      "get": {
        "operationId": "listExamples",
        "responses": {
          "200": {
            "description": "examples",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/examples"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope; see contract for HTTP mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks": {
      "post": {
        "operationId": "submitTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schema.json#/$defs/submission"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/receipt"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Relative status URL for the accepted task",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope; see contract for HTTP mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{task_id}": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "get": {
        "operationId": "getTask",
        "responses": {
          "200": {
            "description": "task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/task"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope; see contract for HTTP mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{task_id}/download": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "get": {
        "operationId": "downloadTask",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "enum": [
                "source",
                "bundle"
              ],
              "default": "bundle"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified attachment; source ZIP or evidence ZIP",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope; see contract for HTTP mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/error"
                }
              }
            }
          }
        }
      }
    }
  }
}
