{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Browser API v1 messages",
  "$defs": {
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "example_id": {
          "const": "sum-array"
        },
        "example_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target": {
          "enum": [
            "linux-aarch64",
            "linux-x86_64"
          ]
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "example_id",
        "example_sha256",
        "target"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "task_id",
        "status_url"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "approved",
            "rejected",
            "abstained",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "outcome",
        "reason"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "ms",
            "KiB"
          ]
        },
        "repetitions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "baseline",
        "candidate",
        "unit",
        "repetitions",
        "uncertainty"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "required": [
        "proposal_id",
        "state",
        "reasons",
        "checks"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "candidate_selected",
            "baseline_retained"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "selected_source": {
          "$ref": "#/$defs/artifact"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "performance_qualified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "worker": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "hardware": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "compiler": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "image_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "worker",
            "hardware",
            "compiler",
            "image_digest"
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "outcome",
        "reason",
        "selected_source",
        "candidates",
        "checks",
        "runtime",
        "peak_memory",
        "performance_qualified",
        "context",
        "report"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "example_id": {
          "anyOf": [
            {
              "const": "sum-array"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "enum": [
                "linux-aarch64",
                "linux-x86_64"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "rejected"
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "backend": {
          "enum": [
            "deterministic",
            "replay",
            "model",
            "unavailable"
          ]
        },
        "backend_identity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_mode": {
          "enum": [
            "native",
            "emulated",
            "unavailable"
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/result"
            },
            {
              "type": "null"
            }
          ]
        },
        "downloads": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "boolean"
            },
            "bundle": {
              "type": "boolean"
            }
          },
          "required": [
            "source",
            "bundle"
          ]
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "example_id",
        "target",
        "state",
        "stage",
        "reason",
        "backend",
        "backend_identity",
        "execution_mode",
        "result",
        "downloads"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/result"
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "failed",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "sum-array"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "c17"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "example_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "text"
            ]
          }
        },
        "target": {
          "anyOf": [
            {
              "enum": [
                "linux-aarch64",
                "linux-x86_64"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "backend": {
          "enum": [
            "deterministic",
            "replay",
            "model",
            "unavailable"
          ]
        },
        "performance_qualified": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "language",
        "description",
        "example_sha256",
        "sources",
        "target",
        "ready",
        "unavailable_reason",
        "backend",
        "performance_qualified"
      ]
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      },
      "required": [
        "schema_version",
        "examples"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "example_not_found",
                "unsupported_target",
                "idempotency_conflict",
                "task_not_found",
                "download_unavailable",
                "backend_unavailable",
                "deadline_exceeded",
                "integrity_error",
                "incompatible_backend",
                "rate_limited",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "task_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "request_id",
            "task_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "error"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/submission"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/examples"
    },
    {
      "$ref": "#/$defs/error"
    }
  ]
}
