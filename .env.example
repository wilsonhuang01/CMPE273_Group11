# Local development defaults; use separate credentials for shared deployments.
COMPOSE_PROJECT_NAME=cmpe273-group11
RABBITMQ_USER=optimizer
RABBITMQ_PASSWORD=optimizer-dev-password
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=5672
REDIS_PASSWORD=redis-dev-password
REDIS_HOST_PORT=6379
COORDINATOR_GRPC_PORT=50051
COORDINATOR_HEALTH_PORT=18080
SCHEDULER_HEALTH_PORT=18081
WORKER_HEALTH_PORT=18082
PROBE_INTERVAL_SECONDS=5
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-dev-password
# ./project serve runs a separate automatic host coordinator. Optional overrides:
# STATE_DIRECTORY=var/service
# GRPC_HOST=127.0.0.1
# GRPC_PORT=50052
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=18083
# TRANSFER_ENABLED=true
# OPTIMIZER_API_TOKEN is a secret; set it in the environment for authenticated clients.
# Remote host binds require TLS and the token. Keep private keys outside the repo:
# RPC_TLS_CERT=/path/to/server-certificate.pem
# RPC_TLS_KEY=/path/to/server-private-key.pem
# Independent scheduler/worker services (see docs/autonomous-workers.md):
# EXECUTION_BACKEND=remote
# COORDINATOR_ENDPOINT=127.0.0.1:50052
# COORDINATOR_TLS=false
# COORDINATOR_CA=/path/to/ca.pem
# WORKER_DIRECTORY=var/worker-a
# WORKER_TARGET=auto
# FLEET_ENABLED=true
# SERVICE_ENABLED=true

# Role-specific agent RPC services (see docs/agent-rpc.md).
# Compose starts all six deterministic/replay agents with development TLS.
# Use a distinct secret for shared deployments and configure it consistently:
# AGENT_API_TOKEN=optimizer-agent-dev-token-change-me-0001
# Host coordinator opt-in, after copying the Compose public certificates:
# AGENT_BACKEND=rpc
# AGENT_TLS=true
# AGENT_CA_DIRECTORY=/absolute/path/to/public-agent-certificates
# AGENT_TIMEOUT_SECONDS=15
# AGENT_ENDPOINTS may override all six role endpoints as a JSON object.

# Optional action H: coordinator-owned limits and held-out stdin/args (JSON).
# Leave unset for the original one-round cohort. See docs/debate.md.
# DEBATE_POLICY_JSON='{"schema_version":1,"max_rounds":2,"max_agent_calls":32,"max_seconds":1800,"heldout_cases":[{"stdin":"7\n1 2 3 4 5 6 7\n","args":[]}]}'
