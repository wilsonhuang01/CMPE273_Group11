# Secret containers only. Terraform never sees a value, so values are absent from
# state, plans and the repository. `./project infra up` fills empty secrets with
# random values generated by Secrets Manager, in memory. Services receive them
# through their execution or instance roles (see identity.tf).

resource "aws_secretsmanager_secret" "service" {
  for_each                = local.secrets
  name                    = "${var.project}/${var.environment}/${each.key}"
  description             = each.value
  kms_key_id              = aws_kms_key.secrets.arn
  recovery_window_in_days = local.secret_recovery_days
  tags                    = { Seed = "random-alphanumeric-48" }
}

# Non-secret service settings that accompany the secrets.
resource "aws_ssm_parameter" "rabbitmq_user" {
  name  = "/${var.project}/${var.environment}/rabbitmq-user"
  type  = "String"
  value = "optimizer"
}
