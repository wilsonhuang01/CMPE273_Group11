{
  "environment": "production",
  "region": "us-west-2",
  "vpc_cidr": "10.42.0.0/16",
  "az_count": 2,
  "enable_nat_gateway": false,
  "interface_endpoints": [
    "ecr.api", "ecr.dkr", "logs", "monitoring", "secretsmanager", "kms", "sts",
    "ssm", "ssmmessages", "ec2messages"
  ],
  "endpoint_az_count": 2,
  "flow_log_traffic": "ALL",
  "worker_architecture": "arm64",
  "worker_instance_types": ["c7g.xlarge", "c6g.xlarge"],
  "worker_capacity": {"min": 1, "desired": 2, "max": 4},
  "max_worker_ceiling": 8,
  "service_capacity": {"coordinator_tasks": 2, "scheduler_tasks": 2, "agent_tasks": 2},
  "enable_bedrock": false,
  "database": {"instance_class": "db.t4g.small", "multi_az": true, "allocated_storage_gb": 20, "max_allocated_storage_gb": 100, "backup_retention_days": 14, "rotation_days": 30},
  "broker": {"instance_type": "mq.m5.large", "deployment_mode": "SINGLE_INSTANCE"},
  "cache": {"node_type": "cache.t4g.small", "nodes": 2},
  "rotation_days": 30,
  "data_protection": "retain",
  "log_retention_days": 90,
  "artifact_retention_days": 90,
  "evidence_retention_days": 731,
  "monthly_budget_usd": 650
}
