{
  "environment": "staging",
  "region": "us-west-2",
  "expires_on": "2026-12-31",
  "vpc_cidr": "10.41.0.0/16",
  "az_count": 2,
  "enable_nat_gateway": false,
  "interface_endpoints": [
    "ecr.api", "ecr.dkr", "logs", "monitoring", "secretsmanager", "kms", "sts",
    "ssm", "ssmmessages", "ec2messages"
  ],
  "endpoint_az_count": 1,
  "worker_architecture": "arm64",
  "worker_instance_types": ["c7g.large", "c6g.large"],
  "worker_capacity": {"min": 0, "desired": 1, "max": 2},
  "max_worker_ceiling": 4,
  "service_capacity": {"coordinator_tasks": 1, "scheduler_tasks": 1, "agent_tasks": 1},
  "enable_bedrock": false,
  "database": {"instance_class": "db.t4g.micro", "multi_az": false, "allocated_storage_gb": 20, "max_allocated_storage_gb": 50, "backup_retention_days": 3, "rotation_days": 30},
  "broker": {"instance_type": "mq.t3.micro", "deployment_mode": "SINGLE_INSTANCE"},
  "cache": {"node_type": "cache.t4g.micro", "nodes": 1},
  "rotation_days": 30,
  "data_protection": "destroy",
  "log_retention_days": 14,
  "artifact_retention_days": 14,
  "evidence_retention_days": 90,
  "monthly_budget_usd": 160
}
