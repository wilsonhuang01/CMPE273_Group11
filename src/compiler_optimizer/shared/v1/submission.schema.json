{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiler optimizer submission manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "language", "sources", "tests", "benchmark_test_ids", "limits"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"$ref": "#/$defs/id"},
    "language": {"enum": ["c17", "cpp17", "cuda17"]},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "tests": {
      "type": "array", "minItems": 0, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "stdin", "expected_stdout", "args"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "stdin": {"$ref": "#/$defs/path"},
          "expected_stdout": {"$ref": "#/$defs/path"},
          "args": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}}
        }
      }
    },
    "benchmark_test_ids": {
      "type": "array", "minItems": 0, "maxItems": 100, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["compile_wall_seconds", "compile_memory_mib", "run_wall_seconds", "run_memory_mib", "output_kib"],
      "properties": {
        "compile_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "compile_memory_mib": {"type": "integer", "minimum": 1, "maximum": 2048},
        "run_wall_seconds": {"type": "integer", "minimum": 1, "maximum": 10},
        "run_memory_mib": {"type": "integer", "minimum": 1, "maximum": 512},
        "output_kib": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"language": {"const": "cuda17"}}},
    "then": {"properties": {
      "sources": {"maxItems": 1}, "tests": {"maxItems": 0},
      "benchmark_test_ids": {"maxItems": 0}
    }},
    "else": {"properties": {
      "tests": {"minItems": 1}, "benchmark_test_ids": {"minItems": 1}
    }}
  }],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
